<!DOCTYPE html>
<html>
<head>
<title>Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

<h2>AWS Cloud Manager</h2>

<div class="row">

<div class="col">

<div class="card p-3">

<h4>EC2</h4>

<h2><%= ec2Count %></h2>

</div>

</div>

<div class="col">

<div class="card p-3">

<h4>S3 Bucket</h4>

<h2><%= bucketCount %></h2>

</div>

</div>

</div>

<br>

<a href="/ec2" class="btn btn-primary">EC2 Manager</a>

<a href="/s3" class="btn btn-success">S3 Manager</a>

</body>

</html>