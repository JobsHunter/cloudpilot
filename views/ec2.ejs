<!DOCTYPE html>
<html>
<head>
<title>EC2</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="container mt-5">

<h2>EC2 Manager</h2>

<table class="table table-bordered">

<tr>

<th>ID</th>

<th>Name</th>

<th>Status</th>

</tr>

<% ec2.forEach(item=>{ %>

<tr>

<td><%= item.id %></td>

<td><%= item.name %></td>

<td><%= item.status %></td>

</tr>

<% }) %>

</table>

<a href="/" class="btn btn-secondary">Dashboard</a>

</body>

</html>